{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker único: sirve la PWA (assets estáticos) y la API /api/* sobre D1, bajo el mismo dominio.
  "name": "vq-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Solo /api/* pasa por el Worker; el resto (incluido el fallback de rutas React) lo sirven los assets.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vq-app",
      "database_id": "REEMPLAZAR_CON_ID_D1_DE_VQ_APP", // identificador (no es un secreto)
      "migrations_dir": "migrations"
    }
  ],
  // Cron cada minuto: continúa lotes de notificaciones y reintentos (12 envíos por tanda por el límite de CPU del plan gratuito)
  // y, SOLO si hay una fuente habilitada con credenciales, la consulta incrementalmente. Sin fuentes habilitadas solo hace
  // dos lecturas de D1 por ejecución y NO llama a Meta. (Ejecutarla cada minuto no garantiza que Meta entregue datos nuevos cada minuto.)
  "triggers": { "crons": ["* * * * *"] },
  // Contacto VAPID (RFC 8292): URL pública, no secreta. Los servicios push la usan para contactar al operador.
  "vars": { "VAPID_SUBJECT": "mailto:configurar-contacto@example.com" },
  "observability": { "enabled": true }
  // Secretos (NO van acá): wrangler secret put META_PAGE_ACCESS_TOKEN | META_INSTAGRAM_ACCESS_TOKEN | VAPID_PUBLIC_KEY | VAPID_PRIVATE_KEY_JWK (ver docs/NOTIFICACIONES.md)
}
